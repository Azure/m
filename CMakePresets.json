      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "clang-aarchh64",
      "environment": {
        "CFLAGS": "--target=arm64-pc-windows-msvc",
        "CXXFLAGS": "--target=arm64-pc-windows-msvc"
      },
      "hidden": true
    },
    {
      "name": "gnuc",
